# Patterns to ignore when building packages.
# This supports shell glob matching, relative path matching, and
# negation (prefixed with !). Only one pattern per line.

.DS_Store
# Common VCS dirs
.git/
.gitignore
.bzr/
.bzrignore
.hg/
.hgignore
.svn/
# Common backup files
*.swp
*.bak
*.tmp
*.orig
*~
# Various IDEs
.project
.idea/
*.tmproj
.vscode/

# Ignore READMEs in the templates folder so Helm doesn't try to parse them
templates/postgres/README.md
templates/zookeeper/README.md
templates/kafka/README.md
templates/kafkadrop/README.md
templates/debezium/README.md
